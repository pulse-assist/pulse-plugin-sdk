{
 "$defs": {
  "JobSpec": {
   "description": "Фоновая работа плагина: команда по расписанию — системная задача шедулера (§13.5).",
   "properties": {
    "name": {
     "maxLength": 60,
     "minLength": 1,
     "title": "Name",
     "type": "string"
    },
    "cron": {
     "maxLength": 100,
     "minLength": 1,
     "title": "Cron",
     "type": "string"
    },
    "command": {
     "maxLength": 100,
     "minLength": 1,
     "title": "Command",
     "type": "string"
    },
    "args": {
     "additionalProperties": true,
     "title": "Args",
     "type": "object"
    },
    "tz": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Tz"
    },
    "description": {
     "default": "",
     "maxLength": 300,
     "title": "Description",
     "type": "string"
    },
    "timeout_sec": {
     "default": 600,
     "maximum": 3600,
     "minimum": 10,
     "title": "Timeout Sec",
     "type": "integer"
    }
   },
   "required": [
    "name",
    "cron",
    "command"
   ],
   "title": "JobSpec",
   "type": "object"
  },
  "MenuItem": {
   "properties": {
    "id": {
     "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
     "title": "Id",
     "type": "string"
    },
    "title": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Title",
     "type": "string"
    },
    "icon": {
     "default": "bi-puzzle",
     "pattern": "^bi-[a-z0-9-]+$",
     "title": "Icon",
     "type": "string"
    },
    "page": {
     "default": "index.html",
     "title": "Page",
     "type": "string"
    }
   },
   "required": [
    "id",
    "title"
   ],
   "title": "MenuItem",
   "type": "object"
  },
  "Runtime": {
   "properties": {
    "kind": {
     "default": "python",
     "enum": [
      "python",
      "docker"
     ],
     "title": "Kind",
     "type": "string"
    },
    "entry": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Entry"
    },
    "path": {
     "default": "backend",
     "title": "Path",
     "type": "string"
    },
    "requirements": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Requirements"
    },
    "dockerfile": {
     "default": "Dockerfile",
     "title": "Dockerfile",
     "type": "string"
    },
    "health": {
     "default": "/health",
     "title": "Health",
     "type": "string"
    }
   },
   "title": "Runtime",
   "type": "object"
  },
  "Setting": {
   "properties": {
    "type": {
     "default": "string",
     "enum": [
      "string",
      "number",
      "integer",
      "boolean"
     ],
     "title": "Type",
     "type": "string"
    },
    "title": {
     "maxLength": 120,
     "minLength": 1,
     "title": "Title",
     "type": "string"
    },
    "description": {
     "default": "",
     "title": "Description",
     "type": "string"
    },
    "enum": {
     "anyOf": [
      {
       "items": {},
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Enum"
    },
    "secret": {
     "default": false,
     "title": "Secret",
     "type": "boolean"
    },
    "default": {
     "default": null,
     "title": "Default"
    }
   },
   "required": [
    "title"
   ],
   "title": "Setting",
   "type": "object"
  },
  "Ui": {
   "properties": {
    "dist": {
     "default": "ui/dist",
     "title": "Dist",
     "type": "string"
    },
    "build": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Build"
    }
   },
   "title": "Ui",
   "type": "object"
  }
 },
 "properties": {
  "id": {
   "title": "Id",
   "type": "string",
   "pattern": "^[a-z][a-z0-9-]{1,39}$"
  },
  "name": {
   "maxLength": 80,
   "minLength": 1,
   "title": "Name",
   "type": "string"
  },
  "version": {
   "title": "Version",
   "type": "string"
  },
  "pulse": {
   "default": ">=1.1",
   "title": "Pulse",
   "type": "string"
  },
  "description": {
   "default": "",
   "maxLength": 500,
   "title": "Description",
   "type": "string"
  },
  "permissions": {
   "items": {
    "enum": [
     "cards:read",
     "cards:write",
     "chat",
     "files",
     "jobs",
     "network",
     "notify",
     "signals:create"
    ]
   },
   "title": "Permissions",
   "type": "array"
  },
  "runtime": {
   "anyOf": [
    {
     "$ref": "#/$defs/Runtime"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "ui": {
   "anyOf": [
    {
     "$ref": "#/$defs/Ui"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "menu": {
   "items": {
    "$ref": "#/$defs/MenuItem"
   },
   "maxItems": 12,
   "title": "Menu",
   "type": "array"
  },
  "settings": {
   "additionalProperties": {
    "$ref": "#/$defs/Setting"
   },
   "title": "Settings",
   "type": "object"
  },
  "skills": {
   "items": {
    "type": "string"
   },
   "title": "Skills",
   "type": "array"
  },
  "commands": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Commands"
  },
  "agents": {
   "items": {
    "type": "string"
   },
   "title": "Agents",
   "type": "array"
  },
  "jobs": {
   "items": {
    "$ref": "#/$defs/JobSpec"
   },
   "maxItems": 20,
   "title": "Jobs",
   "type": "array"
  },
  "install": {
   "default": "INSTALL.md",
   "title": "Install",
   "type": "string"
  }
 },
 "required": [
  "id",
  "name",
  "version"
 ],
 "title": "Manifest",
 "type": "object",
 "$id": "https://github.com/pulse-assist/pulse-plugin-sdk/manifest-1.1.schema.json",
 "x-pulse-contract": "1.1"
}
