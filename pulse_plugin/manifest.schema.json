{
 "$defs": {
  "AgentSetting": {
   "description": "Настройка агента от плагина (§13.8d): галочка/поле в Настройки → Агенты → доступ.\n\nЗначения хранятся у агента в plugin_settings.<id плагина>; при команде агента к этому плагину\nПульс передаёт их заголовком X-Pulse-Agent-Settings (подделать нельзя). Секретов здесь нет.",
   "properties": {
    "type": {
     "default": "boolean",
     "enum": [
      "string",
      "number",
      "integer",
      "boolean"
     ],
     "title": "Type",
     "type": "string"
    },
    "title": {
     "maxLength": 120,
     "minLength": 1,
     "title": "Title",
     "type": "string"
    },
    "description": {
     "default": "",
     "title": "Description",
     "type": "string"
    },
    "enum": {
     "anyOf": [
      {
       "items": {},
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Enum"
    },
    "default": {
     "default": null,
     "title": "Default"
    },
    "warning": {
     "default": "",
     "maxLength": 500,
     "title": "Warning",
     "type": "string"
    }
   },
   "required": [
    "title"
   ],
   "title": "AgentSetting",
   "type": "object"
  },
  "EmbedSpec": {
   "additionalProperties": false,
   "description": "Same-origin embed pages under /plugin-apps/<id>/… (requires permission embed).",
   "properties": {
    "public_paths": {
     "items": {
      "type": "string"
     },
     "maxItems": 40,
     "title": "Public Paths",
     "type": "array"
    }
   },
   "title": "EmbedSpec",
   "type": "object"
  },
  "FileHandler": {
   "additionalProperties": false,
   "description": "File handler for the Files preview panel (K3).",
   "properties": {
    "id": {
     "maxLength": 40,
     "minLength": 1,
     "pattern": "^[a-z][a-z0-9-]*$",
     "title": "Id",
     "type": "string"
    },
    "title": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Title",
     "type": "string"
    },
    "extensions": {
     "items": {
      "type": "string"
     },
     "maxItems": 50,
     "minItems": 1,
     "title": "Extensions",
     "type": "array"
    },
    "path": {
     "maxLength": 200,
     "minLength": 1,
     "title": "Path",
     "type": "string"
    },
    "access": {
     "default": "read",
     "enum": [
      "read",
      "write"
     ],
     "title": "Access",
     "type": "string"
    },
    "preview": {
     "default": true,
     "title": "Preview",
     "type": "boolean"
    },
    "mobile": {
     "default": "view",
     "enum": [
      "view",
      "none"
     ],
     "title": "Mobile",
     "type": "string"
    },
    "scope": {
     "default": "all",
     "enum": [
      "all",
      "own"
     ],
     "title": "Scope",
     "type": "string"
    }
   },
   "required": [
    "id",
    "title",
    "extensions",
    "path"
   ],
   "title": "FileHandler",
   "type": "object"
  },
  "FileProviderSpec": {
   "additionalProperties": false,
   "description": "Хранилище плагина — папка @<id> в «Файлах», у pulse files и в дереве агентов (§13.8b, право files:provide).",
   "properties": {
    "title": {
     "maxLength": 60,
     "minLength": 1,
     "title": "Title",
     "type": "string"
    },
    "icon": {
     "default": "bi-hdd-network",
     "pattern": "^bi-[a-z0-9-]+$",
     "title": "Icon",
     "type": "string"
    },
    "description": {
     "default": "",
     "maxLength": 300,
     "title": "Description",
     "type": "string"
    }
   },
   "required": [
    "title"
   ],
   "title": "FileProviderSpec",
   "type": "object"
  },
  "FileSettings": {
   "additionalProperties": false,
   "description": "File handlers and templates declared by the plugin.",
   "properties": {
    "handlers": {
     "items": {
      "$ref": "#/$defs/FileHandler"
     },
     "maxItems": 20,
     "title": "Handlers",
     "type": "array"
    },
    "templates": {
     "items": {
      "$ref": "#/$defs/FileTemplate"
     },
     "maxItems": 20,
     "title": "Templates",
     "type": "array"
    },
    "provider": {
     "anyOf": [
      {
       "$ref": "#/$defs/FileProviderSpec"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "title": "FileSettings",
   "type": "object"
  },
  "FileTemplate": {
   "additionalProperties": false,
   "description": "Template for «Создать ▾» in Files.",
   "properties": {
    "title": {
     "maxLength": 80,
     "minLength": 1,
     "title": "Title",
     "type": "string"
    },
    "extension": {
     "maxLength": 20,
     "minLength": 1,
     "title": "Extension",
     "type": "string"
    },
    "file": {
     "maxLength": 200,
     "minLength": 1,
     "title": "File",
     "type": "string"
    }
   },
   "required": [
    "title",
    "extension",
    "file"
   ],
   "title": "FileTemplate",
   "type": "object"
  },
  "JobSpec": {
   "description": "Фоновая работа плагина: команда по расписанию — системное задание планировщика (§13.5).",
   "properties": {
    "name": {
     "maxLength": 60,
     "minLength": 1,
     "title": "Name",
     "type": "string"
    },
    "cron": {
     "maxLength": 100,
     "minLength": 1,
     "title": "Cron",
     "type": "string"
    },
    "command": {
     "maxLength": 100,
     "minLength": 1,
     "title": "Command",
     "type": "string"
    },
    "args": {
     "additionalProperties": true,
     "title": "Args",
     "type": "object"
    },
    "tz": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Tz"
    },
    "description": {
     "default": "",
     "maxLength": 300,
     "title": "Description",
     "type": "string"
    },
    "timeout_sec": {
     "default": 600,
     "maximum": 3600,
     "minimum": 10,
     "title": "Timeout Sec",
     "type": "integer"
    }
   },
   "required": [
    "name",
    "cron",
    "command"
   ],
   "title": "JobSpec",
   "type": "object"
  },
  "MenuItem": {
   "properties": {
    "id": {
     "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
     "title": "Id",
     "type": "string"
    },
    "title": {
     "maxLength": 40,
     "minLength": 1,
     "title": "Title",
     "type": "string"
    },
    "icon": {
     "default": "bi-puzzle",
     "pattern": "^bi-[a-z0-9-]+$",
     "title": "Icon",
     "type": "string"
    },
    "page": {
     "default": "index.html",
     "title": "Page",
     "type": "string"
    },
    "app": {
     "anyOf": [
      {
       "maxLength": 200,
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "App"
    }
   },
   "required": [
    "id",
    "title"
   ],
   "title": "MenuItem",
   "type": "object"
  },
  "Runtime": {
   "properties": {
    "kind": {
     "default": "python",
     "enum": [
      "python",
      "docker"
     ],
     "title": "Kind",
     "type": "string"
    },
    "entry": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Entry"
    },
    "path": {
     "default": "backend",
     "title": "Path",
     "type": "string"
    },
    "requirements": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Requirements"
    },
    "dockerfile": {
     "default": "Dockerfile",
     "title": "Dockerfile",
     "type": "string"
    },
    "health": {
     "default": "/health",
     "title": "Health",
     "type": "string"
    }
   },
   "title": "Runtime",
   "type": "object"
  },
  "ServiceProxy": {
   "additionalProperties": false,
   "description": "How the service learns its external path via X-Forwarded-* (K2).",
   "properties": {
    "host_with_prefix": {
     "default": false,
     "title": "Host With Prefix",
     "type": "boolean"
    }
   },
   "title": "ServiceProxy",
   "type": "object"
  },
  "ServiceSpec": {
   "additionalProperties": false,
   "description": "Дополнительный контейнер плагина — OnlyOffice, Redis, nginx и т.п.",
   "properties": {
    "id": {
     "maxLength": 40,
     "minLength": 1,
     "pattern": "^[a-z][a-z0-9-]*$",
     "title": "Id",
     "type": "string"
    },
    "image": {
     "maxLength": 200,
     "minLength": 1,
     "title": "Image",
     "type": "string"
    },
    "port": {
     "maximum": 65535,
     "minimum": 1,
     "title": "Port",
     "type": "integer"
    },
    "health": {
     "default": "/health",
     "title": "Health",
     "type": "string"
    },
    "env": {
     "additionalProperties": {
      "type": "string"
     },
     "title": "Env",
     "type": "object"
    },
    "volumes": {
     "additionalProperties": {
      "type": "string"
     },
     "title": "Volumes",
     "type": "object"
    },
    "memory": {
     "anyOf": [
      {
       "pattern": "^\\d+[kmg]$",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Memory"
    },
    "cpus": {
     "anyOf": [
      {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "number"
        }
       ],
       "ge": 0.1,
       "le": 16
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Cpus"
    },
    "start_timeout": {
     "default": 300,
     "maximum": 1800,
     "minimum": 30,
     "title": "Start Timeout",
     "type": "integer"
    },
    "proxy": {
     "anyOf": [
      {
       "$ref": "#/$defs/ServiceProxy"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "id",
    "image",
    "port"
   ],
   "title": "ServiceSpec",
   "type": "object"
  },
  "Setting": {
   "properties": {
    "type": {
     "default": "string",
     "enum": [
      "string",
      "number",
      "integer",
      "boolean"
     ],
     "title": "Type",
     "type": "string"
    },
    "title": {
     "maxLength": 120,
     "minLength": 1,
     "title": "Title",
     "type": "string"
    },
    "description": {
     "default": "",
     "title": "Description",
     "type": "string"
    },
    "enum": {
     "anyOf": [
      {
       "items": {},
       "type": "array"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Enum"
    },
    "secret": {
     "default": false,
     "title": "Secret",
     "type": "boolean"
    },
    "generate": {
     "default": false,
     "title": "Generate",
     "type": "boolean"
    },
    "default": {
     "default": null,
     "title": "Default"
    }
   },
   "required": [
    "title"
   ],
   "title": "Setting",
   "type": "object"
  },
  "SpeechSpec": {
   "additionalProperties": false,
   "description": "Распознавание речи (§13.8c, право speech:provide): процесс плагина отвечает на POST /speech/transcribe.",
   "properties": {
    "title": {
     "default": "",
     "maxLength": 80,
     "title": "Title",
     "type": "string"
    }
   },
   "title": "SpeechSpec",
   "type": "object"
  },
  "Ui": {
   "properties": {
    "dist": {
     "default": "ui/dist",
     "title": "Dist",
     "type": "string"
    },
    "build": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Build"
    }
   },
   "title": "Ui",
   "type": "object"
  }
 },
 "properties": {
  "id": {
   "title": "Id",
   "type": "string",
   "pattern": "^[a-z][a-z0-9-]{1,39}$"
  },
  "name": {
   "maxLength": 80,
   "minLength": 1,
   "title": "Name",
   "type": "string"
  },
  "version": {
   "title": "Version",
   "type": "string"
  },
  "pulse": {
   "default": ">=1.9",
   "title": "Pulse",
   "type": "string"
  },
  "description": {
   "default": "",
   "maxLength": 500,
   "title": "Description",
   "type": "string"
  },
  "permissions": {
   "items": {
    "enum": [
     "cards:read",
     "cards:write",
     "chat",
     "embed",
     "files",
     "files:open",
     "files:provide",
     "jobs",
     "network",
     "notify",
     "services",
     "signals:create",
     "speech:provide"
    ]
   },
   "title": "Permissions",
   "type": "array"
  },
  "runtime": {
   "anyOf": [
    {
     "$ref": "#/$defs/Runtime"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "services": {
   "items": {
    "$ref": "#/$defs/ServiceSpec"
   },
   "maxItems": 10,
   "title": "Services",
   "type": "array"
  },
  "files": {
   "anyOf": [
    {
     "$ref": "#/$defs/FileSettings"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "embed": {
   "anyOf": [
    {
     "$ref": "#/$defs/EmbedSpec"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "speech": {
   "anyOf": [
    {
     "$ref": "#/$defs/SpeechSpec"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "ui": {
   "anyOf": [
    {
     "$ref": "#/$defs/Ui"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "menu": {
   "items": {
    "$ref": "#/$defs/MenuItem"
   },
   "maxItems": 12,
   "title": "Menu",
   "type": "array"
  },
  "settings": {
   "additionalProperties": {
    "$ref": "#/$defs/Setting"
   },
   "title": "Settings",
   "type": "object"
  },
  "agent_settings": {
   "additionalProperties": {
    "$ref": "#/$defs/AgentSetting"
   },
   "maxProperties": 20,
   "title": "Agent Settings",
   "type": "object"
  },
  "skills": {
   "items": {
    "type": "string"
   },
   "title": "Skills",
   "type": "array"
  },
  "commands": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Commands"
  },
  "check": {
   "anyOf": [
    {
     "maxLength": 100,
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Check"
  },
  "agents": {
   "items": {
    "type": "string"
   },
   "title": "Agents",
   "type": "array"
  },
  "jobs": {
   "items": {
    "$ref": "#/$defs/JobSpec"
   },
   "maxItems": 20,
   "title": "Jobs",
   "type": "array"
  },
  "install": {
   "default": "INSTALL.md",
   "title": "Install",
   "type": "string"
  }
 },
 "required": [
  "id",
  "name",
  "version"
 ],
 "title": "Manifest",
 "type": "object",
 "$id": "https://github.com/pulse-assist/pulse-plugin-sdk/manifest-1.9.schema.json",
 "x-pulse-contract": "1.9"
}
